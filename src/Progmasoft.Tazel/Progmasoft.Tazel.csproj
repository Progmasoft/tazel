<!-- The tazel command. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tazel</AssemblyName>
    <RootNamespace>Progmasoft.Tazel</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Progmasoft.Tazel.Dsl/Progmasoft.Tazel.Dsl.csproj" />
    <ProjectReference Include="../Progmasoft.Tazel.PluginApi/Progmasoft.Tazel.PluginApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="Lzma.Net" />
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Progmasoft.Tazel.Packaging/Progmasoft.Tazel.Packaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Progmasoft.Tazel.Tests" />
    <InternalsVisibleTo Include="Progmasoft.Tazel.Benchmarks" />
    <InternalsVisibleTo Include="Progmasoft.Tazel.Fuzz" />
  </ItemGroup>
</Project>
